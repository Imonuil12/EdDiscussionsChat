<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml"
      fx:controller="main.RoleSelectionController"
      alignment="CENTER" spacing="20" style="-fx-padding: 30;">
    
    <Button text="I'm a Student" onAction="#onStudentSelected" prefWidth="200"/>
    <Button text="I'm a Staff Member" onAction="#onStaffSelected" prefWidth="200"/>
    <Button text="I'm a Reviewer" onAction="#onReviewerSelected" prefWidth="200"/>
    <Button text="I'm an Instructor" onAction="#onInstructorSelected" prefWidth="200"/>

</VBox>
